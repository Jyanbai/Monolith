{
  "name": "monolith-server",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "build:node": "tsc -p tsconfig.node.json",
    "start:node": "node dist/index.node.js",
    "db:migrate:local": "wrangler d1 migrations apply monolith-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply monolith-db --remote",
    "db:reconcile": "npm run db:reconcile:local",
    "db:reconcile:local": "node ../scripts/reconcile-d1-schema.mjs --local",
    "db:reconcile:remote": "node ../scripts/reconcile-d1-schema.mjs --remote",
    "db:seed:local": "wrangler d1 execute monolith-db --local --file=src/migrations/0002_seed.sql",
    "db:seed:test-posts:local": "wrangler d1 execute monolith-db --local --file=src/seeds/seed_test_posts.sql",
    "check": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1037.0",
    "@hono/node-server": "^1.13.7",
    "@libsql/client": "^0.17.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.18",
    "node-cron": "^3.0.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260426.1",
    "@types/node": "^22.10.0",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.58.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.1",
    "eslint-plugin-security": "^4.0.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.85.0"
  }
}
